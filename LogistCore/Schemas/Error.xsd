<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
    targetNamespace="http://www.keypartner.com/logistic-sap/Error"
    xmlns:tns="http://www.keypartner.com/logistic-sap/Error"
    elementFormDefault="qualified">

    <!-- Body di tutte le risposte d'errore (GET e POST) -->
    <xs:element name="ErrorResponse">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="code" type="tns:ErrorCode"/>
                <xs:element name="message" type="xs:string"/>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

    <!-- Codici della GET; quelli della POST si aggiungono nella fase 2B -->
    <xs:simpleType name="ErrorCode">
        <xs:restriction base="xs:string">
            <xs:enumeration value="CARRIER_ID_REQUIRED"/>
            <xs:enumeration value="CARRIER_NOT_FOUND"/>
            <xs:enumeration value="INTERNAL_ERROR"/>
            <xs:enumeration value="DELIVERY_DATA_REQUIRED"/>
			<xs:enumeration value="ORDER_NOT_FOUND"/>
			<xs:enumeration value="INVALID_ORDER_STATUS"/>
        </xs:restriction>
    </xs:simpleType>

</xs:schema>