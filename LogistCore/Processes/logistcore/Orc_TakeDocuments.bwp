<bpws:process exitOnStandardFault="no"
    name="logistcore.Orc_TakeDocuments" suppressJoinFailure="yes"
    targetNamespace="http://xmlns.example.com/20261015145412"
    xmlns:bpws="http://docs.oasis-open.org/wsbpel/2.0/process/executable"
    xmlns:info="http://www.tibco.com/bw/process/info"
    xmlns:ns="http://www.tibco.com/pe/EngineTypes"
    xmlns:ns0="http://www.tibco.com/pe/WriteToLogActivitySchema"
    xmlns:ns1="http://tns.tibco.com/bw/palette/internal/accumulateoutput+1adcfa29-a3db-4f5a-a0d8-829708e6b18b"
    xmlns:ns2="http://schemas.tibco.com/bw/plugins/basic/6.0/Exceptions"
