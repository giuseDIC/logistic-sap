    <tibex:VariableDescriptor type="MemorySaving">
        <task name="flow">
            <endingVariables>
                <variable>Start</variable>
                <variable>CallGetDocuments</variable>
            </endingVariables>
        </task>
        <task name="End">
            <endingVariables>
                <variable>BuildDocumentsResponse</variable>
            </endingVariables>
        </task>
        <task name="ThrowCarrierRequired">
            <endingVariables>
                <variable>ThrowCarrierRequired-input</variable>
            </endingVariables>
        </task>
        <task name="LogCarrierId">
            <endingVariables>
                <variable>LogCarrierId-input</variable>
            </endingVariables>
        </task>
        <task name="CallGetDocuments">
            <endingVariables>
                <variable>CallGetDocuments-input</variable>
            </endingVariables>
        </task>
        <task name="ForEachDocument">
            <endingVariables>
                <variable>TakenDocument</variable>
                <variable>currentRecord</variable>
            </endingVariables>
        </task>
        <task name="CallUpdateDocumentStatus">
            <endingVariables>
                <variable>CallUpdateDocumentStatus-input</variable>
            </endingVariables>
        </task>
        <task name="TakenDocument">
            <endingVariables>
                <variable>TakenDocument-input</variable>
                <variable>CallUpdateDocumentStatus</variable>
            </endingVariables>
        </task>
        <task name="ThrowCarrierNotFound">
            <endingVariables>
                <variable>ThrowCarrierNotFound-input</variable>
            </endingVariables>
        </task>
        <task name="BuildDocumentsResponse">
            <endingVariables>
                <variable>BuildDocumentsResponse-input</variable>
                <variable>takenDocuments</variable>
            </endingVariables>
        </task>
    </tibex:VariableDescriptor>
