    <bpws:import importType="http://www.w3.org/2001/XMLSchema" namespace="http://www.keypartner.com/logistic-sap/Documents"/>
    <bpws:import importType="http://www.w3.org/2001/XMLSchema"
        location="../../Schemas/SapDocuments.xsd" namespace="http://www.keypartner.com/logistic-sap/SapDocuments"/>
    <bpws:import importType="http://www.w3.org/2001/XMLSchema" namespace="http://www.keypartner.com/logistic-sap/Error"/>
    <bpws:variables>
        <bpws:variable element="ns:ProcessContext"
            name="_processContext" sca-bpel:internal="true"/>
        <bpws:variable element="tns:DocumentsRequest" name="Start"
            sca-bpel:internal="true" tibex:parameter="in"/>
        <bpws:variable element="tns:DocumentsResponse" name="End-input"
            sca-bpel:internal="true" tibex:parameter="out"/>
        <bpws:variable element="ns0:ActivityInput"
            name="LogCarrierId-input" sca-bpel:internal="true"/>
        <bpws:variable element="tns1:GetDocumentDetailsRequest"
            name="CallGetDocuments-input" sca-bpel:internal="true"/>
        <bpws:variable element="tns1:GetDocumentDetailsResponse"
            name="CallGetDocuments" sca-bpel:internal="true"/>
        <bpws:variable element="tns1:UpdateDocumentStatusRequest"
            name="CallUpdateDocumentStatus-input" sca-bpel:internal="true"/>
        <bpws:variable element="tns1:UpdateDocumentStatusResponse"
            name="CallUpdateDocumentStatus" sca-bpel:internal="true"/>
        <bpws:variable element="tns:DocumentsResponse"
            name="TakenDocument-input" sca-bpel:internal="true"/>
        <bpws:variable element="tns:DocumentsResponse"
            name="TakenDocument" sca-bpel:internal="true"/>
        <bpws:variable element="ns1:AccumulatedOutput"
            name="takenDocuments" sca-bpel:internal="true"/>
        <bpws:variable element="ns3:ErrorResponse"
            name="ThrowCarrierRequired-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns3:ErrorResponse"
            name="ThrowCarrierNotFound-input" sca-bpel:internal="true"/>
        <bpws:variable name="index" type="xsd:int"/>
        <bpws:variable element="tns:DocumentsResponse"
            name="BuildDocumentsResponse-input" sca-bpel:internal="true"/>
        <bpws:variable element="tns:DocumentsResponse"
            name="BuildDocumentsResponse" sca-bpel:internal="true"/>
    </bpws:variables>
    <bpws:extensions>
        <bpws:extension mustUnderstand="no" namespace="http://www.eclipse.org/gmf/runtime/1.0.2/notation"/>
        <bpws:extension mustUnderstand="no" namespace="http://www.tibco.com/bw/process/info"/>
        <bpws:extension mustUnderstand="no" namespace="http://docs.oasis-open.org/ns/opencsa/sca-bpel/200801"/>
        <bpws:extension mustUnderstand="no" namespace="http://docs.oasis-open.org/ns/opencsa/sca/200912"/>
        <bpws:extension mustUnderstand="no" namespace="http://ns.tibco.com/bw/property"/>
        <bpws:extension mustUnderstand="no" namespace="http://www.tibco.com/bpel/2007/extensions"/>
    </bpws:extensions>
    <bpws:scope name="scope">
        <bpws:flow name="flow">
            <bpws:links>
                <bpws:link name="LogCarrierIdToCallGetDocuments" tibex:linkType="SUCCESS"/>
                <bpws:link name="CallGetDocumentsToThrowCarrierNotFound" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="CallGetDocumentsToIterate" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                <bpws:link name="StartToThrowCarrierRequired" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="StartToLogCarrierId" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                <bpws:link name="ForEachDocumentToMapper" tibex:linkType="SUCCESS"/>
                <bpws:link name="MapperToEnd" tibex:linkType="SUCCESS"/>
            </bpws:links>
            <bpws:extensionActivity>
                <tibex:receiveEvent createInstance="yes"
                    eventTimeout="0" name="Start"
                    tibex:xpdlId="afe58962-3983-4655-a249-ed831fd4b3fb"
                    variable="Start" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:sources>
                        <bpws:source linkName="StartToThrowCarrierRequired">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="string-length(normalize-space($Start/tns:carrierId)) = 0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[string-length(normalize-space($Start/tns:carrierId)) = 0]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="StartToLogCarrierId">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:eventSource>
                        <tibex:StartEvent xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                    </tibex:eventSource>
                </tibex:receiveEvent>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="End-input"
                    name="End"
                    tibex:xpdlId="d62ba50a-cf27-4e61-b048-9205cb6ea1bb" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="MapperToEnd"/>
                    </bpws:targets>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.keypartner.com/logistic-sap/Documents&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;BuildDocumentsResponse&quot;/>&lt;xsl:template name=&quot;End-input&quot; match=&quot;/&quot;>&lt;tns1:DocumentsResponse>&lt;xsl:copy-of select=&quot;$BuildDocumentsResponse/tns1:documents&quot;/>&lt;/tns1:DocumentsResponse>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.internal.end"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:internalactivities="http://ns.tibco.com/bw/core/internalactivity" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/core/internalactivity#//End"/>
                                    <value xsi:type="internalactivities:End"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:throw faultName="ns3:ErrorResponse"
                faultVariable="ThrowCarrierRequired-input"
                name="ThrowCarrierRequired" tibex:xpdlId="92816bc3-a1e8-445a-8614-bd893b04d06e">
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.keypartner.com/logistic-sap/Error&quot; version=&quot;2.0&quot;>&lt;xsl:template name=&quot;ThrowCarrierRequired-input&quot; match=&quot;/&quot;>&lt;tns3:ErrorResponse>&lt;tns3:code>&lt;xsl:value-of select=&quot;&amp;quot;CARRIER_ID_REQUIRED&amp;quot;&quot;/>&lt;/tns3:code>&lt;tns3:message>&lt;xsl:value-of select=&quot;&amp;quot;Il parametro carrierId è obbligatorio&amp;quot;&quot;/>&lt;/tns3:message>&lt;/tns3:ErrorResponse>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <bpws:targets>
                    <bpws:target linkName="StartToThrowCarrierRequired"/>
                </bpws:targets>
            </bpws:throw>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="LogCarrierId-input"
                    name="LogCarrierId"
                    tibex:xpdlId="d1eeb194-e2a3-4090-9b8b-bb50661dbb07" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="StartToLogCarrierId"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogCarrierIdToCallGetDocuments"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://www.tibco.com/pe/WriteToLogActivitySchema&quot; xmlns:tns1=&quot;http://www.keypartner.com/logistic-sap/Documents&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;LogCarrierId-input&quot; match=&quot;/&quot;>&lt;tns2:ActivityInput>&lt;message>&lt;xsl:value-of select=&quot;concat(&amp;quot;GET /documents carrierId &amp;quot;, $Start/tns1:carrierId)&quot;/>&lt;/message>&lt;/tns2:ActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.log"
                            version="6.0.0.001"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Log"/>
                                    <value controlBy="Application"
                                    role="Info"
                                    suppressJobInfo="true" xsi:type="generalactivities:Log"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity
                    inputVariable="CallGetDocuments-input"
                    name="CallGetDocuments"
                    outputVariable="CallGetDocuments"
                    tibex:xpdlId="17c7e3b6-6a46-49ba-9da8-8e0f640f6541"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogCarrierIdToCallGetDocuments"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="CallGetDocumentsToThrowCarrierNotFound">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="count($CallGetDocuments/tns1:record) = 0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[count($CallGetDocuments/tns1:record) = 0]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="CallGetDocumentsToIterate">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.keypartner.com/logistic-sap/Documents&quot; xmlns:tns=&quot;http://www.keypartner.com/logistic-sap/SapDocuments&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;CallGetDocuments-input&quot; match=&quot;/&quot;>&lt;tns:GetDocumentDetailsRequest>&lt;xsl:if test=&quot;$Start/tns1:carrierId&quot;>&lt;tns:carrierId>&lt;xsl:value-of select=&quot;$Start/tns1:carrierId&quot;/>&lt;/tns:carrierId>&lt;/xsl:if>&lt;/tns:GetDocumentDetailsRequest>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        subProcessName="logistcore.SapGetDocumentDetails" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:scope name="ForEachDocument" tibex:group="iterate"
                tibex:indexToGlobal="false" tibex:xpdlId="bbfa0de1-3912-444a-8e2e-ad793b60a65d">
                <bpws:targets>
                    <bpws:target linkName="CallGetDocumentsToIterate"/>
                </bpws:targets>
                <bpws:sources>
                    <bpws:source linkName="ForEachDocumentToMapper"/>
                </bpws:sources>
                <bpws:sequence name="sequence" tibex:group="iterate">
                    <bpws:assign name="GroupInit"
                        tibex:group="groupInit" validate="no">
                        <bpws:copy>
                            <bpws:from expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"><![CDATA[<?xml version="1.0" encoding="UTF-8"?> <xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns="http://tns.tibco.com/bw/palette/internal/accumulateoutput+1adcfa29-a3db-4f5a-a0d8-829708e6b18b" version="2.0"> <xsl:template name="takenDocuments" match="/"> <tns:AccumulatedOutput/></xsl:template> </xsl:stylesheet>]]></bpws:from>
                            <bpws:to variable="takenDocuments"/>
                        </bpws:copy>
                    </bpws:assign>
                    <bpws:forEach counterName="index" name="iterate"
                        parallel="no" tibex:group="iterate">
                        <tibex:DesignExpression name="variableList">
                            <tibex:expression
                                expression="$CallGetDocuments/tns1:record" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                        </tibex:DesignExpression>
                        <bpws:startCounterValue><![CDATA[1]]></bpws:startCounterValue>
                        <bpws:finalCounterValue expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[count($CallGetDocuments/tns1:record)]]></bpws:finalCounterValue>
                        <bpws:scope name="innerScope">
                            <bpws:variables>
                                <bpws:variable
                                    element="tns1:ForEachDocument_Current_Element_record"
                                    name="currentRecord" sca-bpel:internal="true"/>
                            </bpws:variables>
                            <bpws:flow name="flow1">
                                <bpws:links>
                                    <bpws:link
                                    name="CallUpdateDocumentStatusToTakenDocument" tibex:linkType="SUCCESSWITHCONDITION"/>
                                    <bpws:link
                                    name="TakenDocumentToGroupEnd" tibex:linkType="SUCCESS"/>
                                    <bpws:link
                                    name="GroupStartToCallUpdateDocumentStatus" tibex:linkType="SUCCESSWITHCONDITION"/>
                                </bpws:links>
                                <bpws:assign name="GroupStart"
                                    tibex:group="groupStart"
                                    tibex:xpdlId="7088cc81-10ce-4a33-9c14-41eff6245a61" validate="no">
                                    <bpws:sources>
                                    <bpws:source linkName="GroupStartToCallUpdateDocumentStatus">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="string($currentRecord/tns1:status) = &quot;DA GESTIRE&quot;" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[string($currentRecord/tns1:status) = "DA GESTIRE"]]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
                                    <bpws:copy>
                                    <bpws:from expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[($CallGetDocuments/tns1:record)[number($index)]]]></bpws:from>
                                    <bpws:to variable="currentRecord"/>
                                    </bpws:copy>
                                </bpws:assign>
                                <bpws:extensionActivity>
                                    <tibex:activityExtension
                                    name="takenDocuments"
                                    outputVariable="takenDocuments"
                                    tibex:group="groupEnd"
                                    tibex:xpdlId="1adcfa29-a3db-4f5a-a0d8-829708e6b18b" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="TakenDocumentToGroupEnd"/>
                                    </bpws:targets>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.internal.accumulateend"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:internalactivities="http://ns.tibco.com/bw/core/internalactivity" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/core/internalactivity#//AccumulateEnd"/>
                                    <value xsi:type="internalactivities:AccumulateEnd">
                                    <activityNames>TakenDocument</activityNames>
                                    </value>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                    </tibex:activityExtension>
                                </bpws:extensionActivity>
                                <bpws:extensionActivity>
                                    <tibex:extActivity
                                    inputVariable="CallUpdateDocumentStatus-input"
                                    name="CallUpdateDocumentStatus"
                                    outputVariable="CallUpdateDocumentStatus"
                                    tibex:xpdlId="d88bd3e8-8cbb-45f0-ad44-17eb8765e6b2"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="GroupStartToCallUpdateDocumentStatus"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="CallUpdateDocumentStatusToTakenDocument">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="$CallUpdateDocumentStatus/tns1:confirmation = true()" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>

                                    <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[$CallUpdateDocumentStatus/tns1:confirmation = true()]]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.keypartner.com/logistic-sap/SapDocuments&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;currentRecord&quot;/>&lt;xsl:template name=&quot;CallUpdateDocumentStatus-input&quot; match=&quot;/&quot;>&lt;tns:UpdateDocumentStatusRequest>&lt;tns:documentId>&lt;xsl:value-of select=&quot;$currentRecord/tns:documentId&quot;/>&lt;/tns:documentId>&lt;tns:status>&lt;xsl:value-of select=&quot;&amp;quot;GESTITO&amp;quot;&quot;/>&lt;/tns:status>&lt;/tns:UpdateDocumentStatusRequest>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    subProcessName="logistcore.SapUpdateDocumentStatus" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                    </tibex:extActivity>
                                </bpws:extensionActivity>
                                <bpws:extensionActivity>
                                    <tibex:activityExtension
                                    inputVariable="TakenDocument-input"
                                    name="TakenDocument"
                                    outputVariable="TakenDocument"
                                    tibex:xpdlId="bea877f7-7ae3-494e-8c8f-78aa5677731e" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="CallUpdateDocumentStatusToTakenDocument"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="TakenDocumentToGroupEnd"/>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.keypartner.com/logistic-sap/Documents&quot; xmlns:tns=&quot;http://www.keypartner.com/logistic-sap/SapDocuments&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;currentRecord&quot;/>&lt;xsl:template name=&quot;TakenDocument-input&quot; match=&quot;/&quot;>&lt;tns1:DocumentsResponse>&lt;tns1:documents>&lt;tns1:documentId>&lt;xsl:value-of select=&quot;$currentRecord/tns:documentId&quot;/>&lt;/tns1:documentId>&lt;tns1:status>&lt;xsl:value-of select=&quot;&amp;quot;GESTITO&amp;quot;&quot;/>&lt;/tns1:status>&lt;tns1:destination>&lt;xsl:value-of select=&quot;$currentRecord/tns:destination&quot;/>&lt;/tns1:destination>&lt;/tns1:documents>&lt;/tns1:DocumentsResponse>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.mapper"
                                    version="6.0.0.001"
                                    xmlns:Documents="http://www.keypartner.com/logistic-sap/Documents"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties
                                    name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Mapper"/>
                                    <value
                                    inputQName="Documents:DocumentsResponse" xsi:type="generalactivities:Mapper"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                    </tibex:config>
                                    </tibex:activityExtension>
                                </bpws:extensionActivity>
                            </bpws:flow>
                        </bpws:scope>
                    </bpws:forEach>
                </bpws:sequence>
            </bpws:scope>
            <bpws:throw faultName="ns3:ErrorResponse"
                faultVariable="ThrowCarrierNotFound-input"
                name="ThrowCarrierNotFound" tibex:xpdlId="39395dcd-b1d2-4756-89db-53da6bfb2b62">
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.keypartner.com/logistic-sap/Error&quot; xmlns:tns1=&quot;http://www.keypartner.com/logistic-sap/Documents&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;ThrowCarrierNotFound-input&quot; match=&quot;/&quot;>&lt;tns3:ErrorResponse>&lt;tns3:code>&lt;xsl:value-of select=&quot;&amp;quot;CARRIER_NOT_FOUND&amp;quot;&quot;/>&lt;/tns3:code>&lt;tns3:message>&lt;xsl:value-of select=&quot;concat(&amp;quot;Nessun documento per il corriere &amp;quot;, $Start/tns1:carrierId )&quot;/>&lt;/tns3:message>&lt;/tns3:ErrorResponse>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <bpws:targets>
                    <bpws:target linkName="CallGetDocumentsToThrowCarrierNotFound"/>
                </bpws:targets>
            </bpws:throw>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="BuildDocumentsResponse-input"
                    name="BuildDocumentsResponse"
                    outputVariable="BuildDocumentsResponse"
                    tibex:xpdlId="6a0a71f5-1203-4d34-a598-fe22893e44b0" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="ForEachDocumentToMapper"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="MapperToEnd"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.keypartner.com/logistic-sap/Documents&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;takenDocuments&quot;/>&lt;xsl:template name=&quot;BuildDocumentsResponse-input&quot; match=&quot;/&quot;>&lt;tns1:DocumentsResponse>&lt;xsl:copy-of select=&quot;$takenDocuments/tns1:DocumentsResponse/tns1:documents&quot;/>&lt;/tns1:DocumentsResponse>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.mapper"
                            version="6.0.0.001"
                            xmlns:Documents="http://www.keypartner.com/logistic-sap/Documents"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Mapper"/>
                                    <value
                                    inputQName="Documents:DocumentsResponse" xsi:type="generalactivities:Mapper"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
