            <bpws:pick createInstance="yes" name="pick" tibex:xpdlId="2a545eca-55a7-43b5-a6e6-65c5f9e3e8df">
                <bpws:onMessage operation="get" partnerLink="documents"
                    portType="ns:documents"
                    tibex:xpdlId="30881770-07ec-4621-9072-7ca17bfa8c82" variable="get">
                    <bpws:scope name="scope1">
                        <bpws:flow name="flow1">
                            <bpws:links>
                                <bpws:link
                                    name="LogCarrierIdToCallProcess" tibex:linkType="SUCCESS"/>
                                <bpws:link name="CallProcessTogetOut" tibex:linkType="SUCCESS"/>
                            </bpws:links>
                            <bpws:empty name="OnMessageStart"
                                tibex:constructor="onMessageStart" tibex:xpdlId="e7b4ff52-034f-4b27-8548-2e84fb47ba4d"/>
                            <bpws:empty name="OnMessageEnd"
                                tibex:constructor="onMessageEnd" tibex:xpdlId="e7ca4958-2995-4b6c-bad0-960347402d8d"/>
                            <bpws:reply name="getOut" operation="get"
                                partnerLink="documents"
                                portType="ns:documents"
                                tibex:xpdlId="98405505-b7c9-42d0-b40e-9f478e940fbc" variable="getOut-input">
                                <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns2=&quot;http://xmlns.example.com/20261013125342PLT&quot; xmlns:tns21=&quot;http://www.keypartner.com/logistic-sap/SapDocuments&quot; xmlns:tns=&quot;http://www.keypartner.com/logistic-sap/Documents&quot; version=&quot;2.0&quot;>&#xa;    &lt;xsl:param name=&quot;CallGetDocuments&quot;/>&#xa;    &lt;xsl:template name=&quot;getOut-input&quot; match=&quot;/&quot;>&#xa;        &lt;tns:DocumentsResponse>&#xa;            &lt;xsl:for-each select=&quot;$CallGetDocuments/tns21:record&quot;>&#xa;                &lt;tns:documents>&#xa;                    &lt;tns:documentId>&#xa;                        &lt;xsl:value-of select=&quot;tns21:documentId&quot;/>&#xa;                    &lt;/tns:documentId>&#xa;                    &lt;tns:status>&#xa;                        &lt;xsl:value-of select=&quot;tns21:status&quot;/>&#xa;                    &lt;/tns:status>&#xa;                    &lt;tns:destination>&#xa;                        &lt;xsl:value-of select=&quot;tns21:destination&quot;/>&#xa;                    &lt;/tns:destination>&#xa;                &lt;/tns:documents>&#xa;            &lt;/xsl:for-each>&#xa;        &lt;/tns:DocumentsResponse>&#xa;    &lt;/xsl:template>&#xa;&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <tibex:inputBinding expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0">&lt;?xml version="1.0" encoding="UTF-8"?&gt;
&lt;xsl:stylesheet xmlns:xsl="http://www.w3.org/1999/XSL/Transform" xmlns:tns2="http://xmlns.example.com/20261013125342PLT" xmlns:tns21="http://www.keypartner.com/logistic-sap/SapDocuments" xmlns:tns="http://www.keypartner.com/logistic-sap/Documents" version="2.0"&gt;&lt;xsl:param name="CallGetDocuments"/&gt;&lt;xsl:template name="getOut-input" match="/"&gt;&lt;tns2:getResponse&gt;&lt;item&gt;&lt;tns:DocumentsResponse&gt;&lt;xsl:for-each select="$CallGetDocuments/tns21:record"&gt;&lt;tns:documents&gt;&lt;tns:documentId&gt;&lt;xsl:value-of select="tns21:documentId"/&gt;&lt;/tns:documentId&gt;&lt;tns:status&gt;&lt;xsl:value-of select="tns21:status"/&gt;&lt;/tns:status&gt;&lt;tns:destination&gt;&lt;xsl:value-of select="tns21:destination"/&gt;&lt;/tns:destination&gt;&lt;/tns:documents&gt;&lt;/xsl:for-each&gt;&lt;/tns:DocumentsResponse&gt;&lt;/item&gt;&lt;/tns2:getResponse&gt;&lt;/xsl:template&gt;&lt;/xsl:stylesheet&gt;</tibex:inputBinding>
                                <bpws:targets>
                                    <bpws:target linkName="CallProcessTogetOut"/>
                                </bpws:targets>
                            </bpws:reply>
                            <bpws:extensionActivity>
                                <tibex:activityExtension
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.tibco.com/pe/WriteToLogActivitySchema&quot; xmlns:tns1=&quot;http://xmlns.example.com/Main_Document/parameters&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;get&quot;/>&lt;xsl:template name=&quot;LogCarrierId-input&quot; match=&quot;/&quot;>&lt;tns:ActivityInput>&lt;message>&lt;xsl:value-of select=&quot;$get/parameters/tns1:documentsGetParameters/tns1:carrierId&quot;/>&lt;/message>&lt;/tns:ActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>"
                                    expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"
