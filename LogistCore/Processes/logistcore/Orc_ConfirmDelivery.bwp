<bpws:process exitOnStandardFault="no"
    name="logistcore.Orc_ConfirmDelivery" suppressJoinFailure="yes"
    targetNamespace="http://xmlns.example.com/20261015162659"
    xmlns:bpws="http://docs.oasis-open.org/wsbpel/2.0/process/executable"
    xmlns:info="http://www.tibco.com/bw/process/info"
    xmlns:ns="http://www.tibco.com/pe/EngineTypes"
    xmlns:ns0="http://www.keypartner.com/logistic-sap/Delivery"
    xmlns:ns1="http://www.keypartner.com/logistic-sap/Error"
    xmlns:ns2="http://www.tibco.com/pe/WriteToLogActivitySchema"
    xmlns:ns3="http://www.keypartner.com/logistic-sap/DeliveryConfirmation"
