    </tibex:NamespaceRegistry>
    <bpws:import importType="http://www.w3.org/2001/XMLSchema" namespace="http://www.keypartner.com/logistic-sap/Delivery"/>
    <bpws:import importType="http://www.w3.org/2001/XMLSchema" namespace="http://www.keypartner.com/logistic-sap/Error"/>
    <bpws:import importType="http://www.w3.org/2001/XMLSchema" namespace="http://www.keypartner.com/logistic-sap/DeliveryConfirmation"/>
    <bpws:import importType="http://www.w3.org/2001/XMLSchema" namespace="http://www.keypartner.com/logistic-sap/SapDocuments"/>
    <bpws:variables>
        <bpws:variable element="ns:ProcessContext"
            name="_processContext" sca-bpel:internal="true"/>
        <bpws:variable element="ns0:DeliveryRequest" name="Start"
            sca-bpel:internal="true" tibex:parameter="in"/>
        <bpws:variable element="ns0:DeliveryResponse" name="End-input"
            sca-bpel:internal="true" tibex:parameter="out"/>
        <bpws:variable element="ns2:ActivityInput"
            name="LogDelivery-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns0:DeliveryResponse"
            name="BuildDeliveryResponse-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns0:DeliveryResponse"
            name="BuildDeliveryResponse" sca-bpel:internal="true"/>
        <bpws:variable element="ns3:DeliveryConfirmation"
            name="CallAtSendDeliveryConfirmation-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns4:ConvertExternalCodeRequest"
            name="CallConvertExternalCode-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns4:ConvertExternalCodeResponse"
            name="CallConvertExternalCode" sca-bpel:internal="true"/>
        <bpws:variable element="ns4:GetDocumentDetailsRequest"
            name="CallGetDocumentDetails-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns4:GetDocumentDetailsResponse"
            name="CallGetDocumentDetails" sca-bpel:internal="true"/>
        <bpws:variable name="FaultName" sca-bpel:internal="true" type="xsd:string"/>
        <bpws:variable element="ns:OptionalErrorReport"
            name="_errorOptional" sca-bpel:internal="true"/>
        <bpws:variable element="ns1:ErrorResponse"
            name="ThrowDeliveryDataRequired-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns1:ErrorResponse"
            name="ThrowOrderNotFound-input" sca-bpel:internal="true"/>
        <bpws:variable element="ns1:ErrorResponse"
            name="ThrowInvalidOrderStatus-input" sca-bpel:internal="true"/>
    </bpws:variables>
    <bpws:extensions>
        <bpws:extension mustUnderstand="no" namespace="http://www.eclipse.org/gmf/runtime/1.0.2/notation"/>
        <bpws:extension mustUnderstand="no" namespace="http://www.tibco.com/bw/process/info"/>
        <bpws:extension mustUnderstand="no" namespace="http://docs.oasis-open.org/ns/opencsa/sca-bpel/200801"/>
        <bpws:extension mustUnderstand="no" namespace="http://docs.oasis-open.org/ns/opencsa/sca/200912"/>
        <bpws:extension mustUnderstand="no" namespace="http://ns.tibco.com/bw/property"/>
        <bpws:extension mustUnderstand="no" namespace="http://www.tibco.com/bpel/2007/extensions"/>
    </bpws:extensions>
    <bpws:scope name="scope">
        <bpws:flow name="flow">
            <bpws:links>
                <bpws:link name="StartToLogDelivery" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                <bpws:link name="StartToThrowDeliveryDataRequired" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="LogDeliveryToCallConvertExternalCode" tibex:linkType="SUCCESS"/>
                <bpws:link
                    name="CallConvertExternalCodeToCallGetDocumentDetails" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                <bpws:link name="CallGetDocumentDetailsToCallProcess" tibex:linkType="SUCCESSWITHNOCONDITION"/>
                <bpws:link
                    name="CallConvertExternalCodeToThrowOrderNotFound" tibex:linkType="SUCCESSWITHCONDITION"/>
                <bpws:link name="CallProcessToMapper" tibex:linkType="SUCCESS"/>
                <bpws:link name="MapperToEnd" tibex:linkType="SUCCESS"/>
                <bpws:link
                    name="CallGetDocumentDetailsToThrowInvalidOrderStatus" tibex:linkType="SUCCESSWITHCONDITION"/>
            </bpws:links>
            <bpws:extensionActivity>
                <tibex:receiveEvent createInstance="yes"
                    eventTimeout="0" name="Start"
                    tibex:xpdlId="d4e0c211-a4f9-44e8-a4c4-ba3771f357cd"
                    variable="Start" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:sources>
                        <bpws:source linkName="StartToLogDelivery">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source
                            linkName="StartToThrowDeliveryDataRequired"
                            tibex:faultDetailsVar="Start" tibex:faultNameVar="FaultName">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="string-length(normalize-space($Start/ns0:externalOrderCode)) = 0 or not(exists($Start/ns0:deliveryDate))" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[string-length(normalize-space($Start/ns0:externalOrderCode)) = 0 or not(exists($Start/ns0:deliveryDate))]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:eventSource>
                        <tibex:StartEvent xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                    </tibex:eventSource>
                </tibex:receiveEvent>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension inputVariable="End-input"
                    name="End"
                    tibex:xpdlId="cd03728f-bf29-4106-a464-20c149007ebf" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="MapperToEnd"/>
                    </bpws:targets>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.keypartner.com/logistic-sap/Delivery&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;BuildDeliveryResponse&quot;/>&lt;xsl:template name=&quot;End-input&quot; match=&quot;/&quot;>&lt;tns:DeliveryResponse>&lt;tns:message>&lt;xsl:value-of select=&quot;$BuildDeliveryResponse/tns:message&quot;/>&lt;/tns:message>&lt;/tns:DeliveryResponse>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.internal.end"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:internalactivities="http://ns.tibco.com/bw/core/internalactivity" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/core/internalactivity#//End"/>
                                    <value xsi:type="internalactivities:End"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:throw faultName="ns1:ErrorResponse"
                faultVariable="ThrowDeliveryDataRequired-input"
                name="ThrowDeliveryDataRequired" tibex:xpdlId="b39c03d4-694c-4822-8c30-1e5ca40d2305">
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.keypartner.com/logistic-sap/Error&quot; version=&quot;2.0&quot;>&lt;xsl:template name=&quot;ThrowDeliveryDataRequired-input&quot; match=&quot;/&quot;>&lt;tns3:ErrorResponse>&lt;tns3:code>&lt;xsl:value-of select=&quot;&amp;quot;DELIVERY_DATA_REQUIRED&amp;quot;&quot;/>&lt;/tns3:code>&lt;tns3:message>&lt;xsl:value-of select=&quot;&amp;quot;externalOrderCode e deliveryDate sono obbligatori&amp;quot;&quot;/>&lt;/tns3:message>&lt;/tns3:ErrorResponse>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <bpws:targets>
                    <bpws:target linkName="StartToThrowDeliveryDataRequired"/>
                </bpws:targets>
            </bpws:throw>
            <bpws:throw faultName="ns1:ErrorResponse"
                faultVariable="ThrowOrderNotFound-input"
                name="ThrowOrderNotFound" tibex:xpdlId="6b1ac6d2-c583-4dd0-9f57-d68c02003588">
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.keypartner.com/logistic-sap/Error&quot; version=&quot;2.0&quot;>&lt;xsl:template name=&quot;ThrowOrderNotFound-input&quot; match=&quot;/&quot;>&lt;tns3:ErrorResponse>&lt;tns3:code>&lt;xsl:value-of select=&quot;&amp;quot;ORDER_NOT_FOUND&amp;quot;&quot;/>&lt;/tns3:code>&lt;tns3:message>&lt;xsl:value-of select=&quot;&amp;quot;Nessun ordine per il codice indicato&amp;quot;&quot;/>&lt;/tns3:message>&lt;/tns3:ErrorResponse>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <bpws:targets>
                    <bpws:target linkName="CallConvertExternalCodeToThrowOrderNotFound"/>
                </bpws:targets>
            </bpws:throw>
            <bpws:throw faultName="ns1:ErrorResponse"
                faultVariable="ThrowInvalidOrderStatus-input"
                name="ThrowInvalidOrderStatus" tibex:xpdlId="ffed0f2b-7008-4126-97ac-19bb1f7b7515">
                <tibex:inputBindings>
                    <tibex:partBinding
                        expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.keypartner.com/logistic-sap/Error&quot; xmlns:tns1=&quot;http://www.keypartner.com/logistic-sap/SapDocuments&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;CallConvertExternalCode&quot;/>&lt;xsl:param name=&quot;CallGetDocumentDetails&quot;/>&lt;xsl:template name=&quot;ThrowInvalidOrderStatus-input&quot; match=&quot;/&quot;>&lt;tns3:ErrorResponse>&lt;tns3:code>&lt;xsl:value-of select=&quot;&amp;quot;INVALID_ORDER_STATUS&amp;quot;&quot;/>&lt;/tns3:code>&lt;tns3:message>&lt;xsl:value-of select=&quot;concat(&amp;quot;Ordine &amp;quot;, $CallConvertExternalCode/tns1:sapOrderId, &amp;quot; in stato: &amp;quot;, string($CallGetDocumentDetails/tns1:record[1]/tns1:status))&quot;/>&lt;/tns3:message>&lt;/tns3:ErrorResponse>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                </tibex:inputBindings>
                <bpws:targets>
                    <bpws:target linkName="CallGetDocumentDetailsToThrowInvalidOrderStatus"/>
                </bpws:targets>
            </bpws:throw>
            <bpws:extensionActivity>
                <tibex:extActivity
                    inputVariable="CallConvertExternalCode-input"
                    name="CallConvertExternalCode"
                    outputVariable="CallConvertExternalCode"
                    tibex:xpdlId="96d9192d-726a-4d8b-8223-b42dbec99cb9"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="LogDeliveryToCallConvertExternalCode"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="CallConvertExternalCodeToCallGetDocumentDetails">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="CallConvertExternalCodeToThrowOrderNotFound">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="string-length($CallConvertExternalCode/ns4:sapOrderId) = 0" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[string-length($CallConvertExternalCode/ns4:sapOrderId) = 0]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.keypartner.com/logistic-sap/Delivery&quot; xmlns:tns1=&quot;http://www.keypartner.com/logistic-sap/SapDocuments&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;CallConvertExternalCode-input&quot; match=&quot;/&quot;>&lt;tns1:ConvertExternalCodeRequest>&lt;tns1:externalCode>&lt;xsl:value-of select=&quot;$Start/tns:externalOrderCode&quot;/>&lt;/tns1:externalCode>&lt;/tns1:ConvertExternalCodeRequest>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        subProcessName="logistcore.SapConvertExternalCode" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity
                    inputVariable="CallGetDocumentDetails-input"
                    name="CallGetDocumentDetails"
                    outputVariable="CallGetDocumentDetails"
                    tibex:xpdlId="4dc5532f-50e4-4794-be11-16e3f56d4feb"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="CallConvertExternalCodeToCallGetDocumentDetails"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="CallGetDocumentDetailsToCallProcess">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[##otherwise##]]></bpws:transitionCondition>
                        </bpws:source>
                        <bpws:source linkName="CallGetDocumentDetailsToThrowInvalidOrderStatus">
                            <tibex:DesignExpression>
                                <tibex:expression
                                    expression="string($CallGetDocumentDetails/ns4:record[1]/ns4:status ) != &quot;GESTITO&quot;" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                            </tibex:DesignExpression>
                            <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[string($CallGetDocumentDetails/ns4:record[1]/ns4:status ) != "GESTITO"]]></bpws:transitionCondition>
                        </bpws:source>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.keypartner.com/logistic-sap/SapDocuments&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;CallConvertExternalCode&quot;/>&lt;xsl:template name=&quot;CallGetDocumentDetails-input&quot; match=&quot;/&quot;>&lt;tns1:GetDocumentDetailsRequest>&lt;tns1:documentId>&lt;xsl:value-of select=&quot;$CallConvertExternalCode/tns1:sapOrderId&quot;/>&lt;/tns1:documentId>&lt;/tns1:GetDocumentDetailsRequest>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        subProcessName="logistcore.SapGetDocumentDetails" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="LogDelivery-input" name="LogDelivery"
                    tibex:xpdlId="83ac6027-9cb1-4c37-8402-801b8a113ad2" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="StartToLogDelivery"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="LogDeliveryToCallConvertExternalCode"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns4=&quot;http://www.tibco.com/pe/WriteToLogActivitySchema&quot; version=&quot;2.0&quot;>&lt;xsl:template name=&quot;LogDelivery-input&quot; match=&quot;/&quot;>&lt;tns4:ActivityInput>&lt;message>&lt;xsl:value-of select=&quot;&amp;quot;test&amp;quot;&quot;/>&lt;/message>&lt;/tns4:ActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.log"
                            version="6.0.0.001"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Log"/>
                                    <value controlBy="Application"
                                    role="Info"
                                    suppressJobInfo="true" xsi:type="generalactivities:Log"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:extActivity
                    inputVariable="CallAtSendDeliveryConfirmation-input"
                    name="CallAtSendDeliveryConfirmation"
                    tibex:xpdlId="8ce67b75-0684-4e92-a814-dfea11a0800b"
                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="CallGetDocumentDetailsToCallProcess"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="CallProcessToMapper"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding coercion=""
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.keypartner.com/logistic-sap/SapDocuments&quot; xmlns:tns2=&quot;http://www.keypartner.com/logistic-sap/DeliveryConfirmation&quot; xmlns:tns=&quot;http://www.keypartner.com/logistic-sap/Delivery&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;CallConvertExternalCode&quot;/>&lt;xsl:param name=&quot;Start&quot;/>&lt;xsl:template name=&quot;CallAtSendDeliveryConfirmation-input&quot; match=&quot;/&quot;>&lt;tns2:DeliveryConfirmation>&lt;tns2:sapOrderId>&lt;xsl:value-of select=&quot;$CallConvertExternalCode/tns1:sapOrderId&quot;/>&lt;/tns2:sapOrderId>&lt;tns2:deliveryDate>&lt;xsl:value-of select=&quot;$Start/tns:deliveryDate&quot;/>&lt;/tns2:deliveryDate>&lt;xsl:if test=&quot;$Start/tns:notes&quot;>&lt;tns2:notes>&lt;xsl:value-of select=&quot;$Start/tns:notes&quot;/>&lt;/tns2:notes>&lt;/xsl:if>&lt;/tns2:DeliveryConfirmation>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:CallProcess
                        subProcessName="logistcore.At_SendDeliveryConfirmation" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                </tibex:extActivity>
            </bpws:extensionActivity>
            <bpws:extensionActivity>
                <tibex:activityExtension
                    inputVariable="BuildDeliveryResponse-input"
                    name="BuildDeliveryResponse"
                    outputVariable="BuildDeliveryResponse"
                    tibex:xpdlId="51563610-8036-4998-b062-2ab37dc0a657" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                    <bpws:targets>
                        <bpws:target linkName="CallProcessToMapper"/>
                    </bpws:targets>
                    <bpws:sources>
                        <bpws:source linkName="MapperToEnd"/>
                    </bpws:sources>
                    <tibex:inputBindings>
                        <tibex:inputBinding
                            expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.keypartner.com/logistic-sap/Delivery&quot; version=&quot;2.0&quot;>&lt;xsl:template name=&quot;BuildDeliveryResponse-input&quot; match=&quot;/&quot;>&lt;tns:DeliveryResponse>&lt;tns:message>&lt;xsl:value-of select=&quot;&amp;quot;Presa in carico della consegna effettuata&amp;quot;&quot;/>&lt;/tns:message>&lt;/tns:DeliveryResponse>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                    </tibex:inputBindings>
                    <tibex:config>
                        <bwext:BWActivity
                            activityTypeID="bw.generalactivities.mapper"
                            version="6.0.0.001"
                            xmlns:Delivery="http://www.keypartner.com/logistic-sap/Delivery"
                            xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                            xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                            xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                            <activityConfig>
                                <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Mapper"/>
                                    <value
                                    inputQName="Delivery:DeliveryResponse" xsi:type="generalactivities:Mapper"/>
                                </properties>
                            </activityConfig>
                        </bwext:BWActivity>
                    </tibex:config>
                </tibex:activityExtension>
            </bpws:extensionActivity>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
