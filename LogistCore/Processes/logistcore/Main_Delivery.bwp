            </endingVariables>
        </task>
        <task name="LogUnexpected">
            <endingVariables>
                <variable>LogUnexpected-input1</variable>
                <variable>FaultDetails</variable>
            </endingVariables>
        </task>
        <task name="postError500">
            <endingVariables>
                <variable>postError500-input</variable>
            </endingVariables>
        </task>
    </tibex:VariableDescriptor>
