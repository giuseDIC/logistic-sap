                            <bpws:throw faultName="ns2:ErrorResponse"
                                faultVariable="OrderNotFound-input"
                                name="OrderNotFound" tibex:xpdlId="12cf7745-2e88-4811-8401-e0bce10edcfe">
                                <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.keypartner.com/logistic-sap/Error&quot; version=&quot;2.0&quot;>&lt;xsl:template name=&quot;OrderNotFound-input&quot; match=&quot;/&quot;>&lt;tns:ErrorResponse>&lt;tns:code>&lt;xsl:value-of select=&quot;&amp;quot;ORDER_NOT_FOUND&amp;quot;&quot;/>&lt;/tns:code>&lt;tns:message>&lt;xsl:value-of select=&quot;&amp;quot;Nessun ordine per il codice indicato&amp;quot;&quot;/>&lt;/tns:message>&lt;/tns:ErrorResponse>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <bpws:targets>
                                    <bpws:target linkName="CallConvertExternalCodeToOrderNotFound"/>
                                </bpws:targets>
                            </bpws:throw>
                            <bpws:extensionActivity>
                                <tibex:extActivity
                                    inputVariable="CallGetDocumentDetails-input"
                                    name="CallGetDocumentDetails"
                                    outputVariable="CallGetDocumentDetails"
                                    tibex:xpdlId="893e3f86-b843-446d-b4fe-0df9e09be650"
                                    type="bw.generalactivities.callprocess" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                    <bpws:targets>
                                    <bpws:target linkName="CallConvertExternalCodeToCallGetDocumentDetails"/>
                                    </bpws:targets>
                                    <bpws:sources>
                                    <bpws:source linkName="CallGetDocumentDetailsToThrowInvalidOrderStatus">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="string($CallGetDocumentDetails/tns1:record[1]/tns1:status) != &quot;GESTITO&quot;" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[string($CallGetDocumentDetails/tns1:record[1]/tns1:status) != "GESTITO"]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="CallGetDocumentDetailsTopostOut">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="##otherwise##" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[##otherwise##]]></bpws:transitionCondition>
                                    </bpws:source>
                                    </bpws:sources>
                                    <tibex:inputBindings>
                                    <tibex:inputBinding coercion=""
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns3=&quot;http://www.keypartner.com/logistic-sap/SapDocuments&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;CallConvertExternalCode&quot;/>&lt;xsl:template name=&quot;CallGetDocumentDetails-input&quot; match=&quot;/&quot;>&lt;tns3:GetDocumentDetailsRequest>&lt;tns3:documentId>&lt;xsl:value-of select=&quot;$CallConvertExternalCode/tns3:sapOrderId&quot;/>&lt;/tns3:documentId>&lt;/tns3:GetDocumentDetailsRequest>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                    </tibex:inputBindings>
                                    <tibex:CallProcess
                                    subProcessName="logistcore.SapGetDocumentDetails" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions"/>
                                </tibex:extActivity>
                            </bpws:extensionActivity>
                            <bpws:throw faultName="ns2:ErrorResponse"
                                faultVariable="ThrowInvalidOrderStatus-input"
                                name="ThrowInvalidOrderStatus" tibex:xpdlId="e5f8867a-dc49-4131-9f72-4a3ef3a98e8b">
                                <tibex:inputBindings>
                                    <tibex:partBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns=&quot;http://www.keypartner.com/logistic-sap/Error&quot; xmlns:tns3=&quot;http://www.keypartner.com/logistic-sap/SapDocuments&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;CallConvertExternalCode&quot;/>&lt;xsl:param name=&quot;CallGetDocumentDetails&quot;/>&lt;xsl:template name=&quot;ThrowInvalidOrderStatus-input&quot; match=&quot;/&quot;>&lt;tns:ErrorResponse>&lt;tns:code>&lt;xsl:value-of select=&quot;&amp;quot;INVALID_ORDER_STATUS&amp;quot;&quot;/>&lt;/tns:code>&lt;tns:message>&lt;xsl:value-of select=&quot;concat(&amp;quot;Ordine &amp;quot;,$CallConvertExternalCode/tns3:sapOrderId,&amp;quot; in stato &amp;quot;, string($CallGetDocumentDetails/tns3:record[1]/tns3:status))&quot;/>&lt;/tns:message>&lt;/tns:ErrorResponse>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <bpws:targets>
                                    <bpws:target linkName="CallGetDocumentDetailsToThrowInvalidOrderStatus"/>
                                </bpws:targets>
                            </bpws:throw>
                        </bpws:flow>
                    </bpws:scope>
                </bpws:onMessage>
            </bpws:pick>
        </bpws:flow>
    </bpws:scope>
</bpws:process>
