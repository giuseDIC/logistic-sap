    <tibex:VariableDescriptor type="MemorySaving">
        <task name="flow1">
            <endingVariables>
                <variable>post</variable>
                <variable>CallConvertExternalCode</variable>
            </endingVariables>
        </task>
        <task name="postOut">
            <endingVariables>
                <variable>postOut-input</variable>
            </endingVariables>
        </task>
        <task name="ThrowDeliveryDataRequired">
            <endingVariables>
                <variable>ThrowDeliveryDataRequired-input</variable>
            </endingVariables>
        </task>
        <task name="LogDelivery">
            <endingVariables>
                <variable>LogDelivery-input</variable>
            </endingVariables>
        </task>
        <task name="CallConvertExternalCode">
            <endingVariables>
                <variable>CallConvertExternalCode-input</variable>
            </endingVariables>
        </task>
        <task name="OrderNotFound">
            <endingVariables>
                <variable>OrderNotFound-input</variable>
            </endingVariables>
        </task>
        <task name="CallGetDocumentDetails">
            <endingVariables>
                <variable>CallGetDocumentDetails-input</variable>
            </endingVariables>
        </task>
        <task name="ThrowInvalidOrderStatus">
            <endingVariables>
                <variable>ThrowInvalidOrderStatus-input</variable>
                <variable>CallGetDocumentDetails</variable>
            </endingVariables>
        </task>
        <task name="LogError">
            <endingVariables>
                <variable>LogError-input</variable>
            </endingVariables>
        </task>
        <task name="PostError400">
