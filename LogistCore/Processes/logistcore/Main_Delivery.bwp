            <plnk:partnerLinkType name="partnerLinkType">
                <plnk:role name="use" portType="tns:deliveries"/>
            </plnk:partnerLinkType>
            <wsdl:import namespace="http://www.keypartner.com/logistic-sap/Delivery"/>
            <wsdl:import namespace="http://tns.tibco.com/bw/REST"/>
            <wsdl:import namespace="http://www.keypartner.com/logistic-sap/Error"/>
            <wsdl:message name="postRequest">
                <wsdl:part element="extns:DeliveryRequest" name="item" tibex:hasMultipleNamespaces="false"/>
                <wsdl:part element="extns1:httpHeaders"
                    name="httpHeaders" tibex:source="bw.rest"/>
            </wsdl:message>
            <wsdl:message name="postResponse">
                <wsdl:part element="extns:DeliveryResponse" name="item" tibex:hasMultipleNamespaces="false"/>
            </wsdl:message>
            <wsdl:message name="post4XXFaultMessage">
                <wsdl:part element="extns1:client4XXError" name="clientError"/>
            </wsdl:message>
            <wsdl:message name="post5XXFaultMessage">
                <wsdl:part element="extns1:server5XXError" name="serverError"/>
            </wsdl:message>
            <wsdl:message name="post400FaultMessage">
                <wsdl:part element="extns2:ErrorResponse"
                    name="server-400-BadRequest"
                    tibex:reasonPhrase="Bad Request" tibex:statusCode="400"/>
            </wsdl:message>
            <wsdl:message name="post404FaultMessage">
                <wsdl:part element="extns2:ErrorResponse"
                    name="server-404-NotFound"
                    tibex:reasonPhrase="Not Found" tibex:statusCode="404"/>
            </wsdl:message>
            <wsdl:message name="post409FaultMessage">
                <wsdl:part element="extns2:ErrorResponse"
                    name="server-409-Conflict"
                    tibex:reasonPhrase="Conflict" tibex:statusCode="409"/>
            </wsdl:message>
            <wsdl:message name="post202FaultMessage">
                <wsdl:part element="extns:DeliveryResponse"
                    name="server-202-Accepted"
                    tibex:reasonPhrase="Accepted" tibex:statusCode="202"/>
            </wsdl:message>
            <wsdl:message name="post500FaultMessage">
                <wsdl:part element="extns2:ErrorResponse"
                    name="server-500-InternalServerError"
                    tibex:reasonPhrase="Internal Server Error" tibex:statusCode="500"/>
            </wsdl:message>
            <wsdl:portType name="deliveries"
                tibex:bw.rest.apipath="/deliveries"
                tibex:bw.rest.basepath="Main_Delivery"
                tibex:bw.rest.resource="Service Descriptors/logistcore.Main_Delivery-Main_Delivery.json"
                tibex:bw.rest.resource.source="generated" tibex:source="bw.rest.service">
                <wsdl:documentation>Main_Delivery service</wsdl:documentation>
                <wsdl:operation name="post">
                    <wsdl:documentation>postMain_Delivery</wsdl:documentation>
                    <wsdl:input message="tns:postRequest" name="postInput"/>
                    <wsdl:output message="tns:postResponse" name="postOutput"/>
                    <wsdl:fault message="tns:post4XXFaultMessage" name="clientFault"/>
                    <wsdl:fault message="tns:post5XXFaultMessage" name="serverFault"/>
                    <wsdl:fault message="tns:post400FaultMessage" name="server-400-Fault"/>
                    <wsdl:fault message="tns:post404FaultMessage" name="server-404-Fault"/>
                    <wsdl:fault message="tns:post409FaultMessage" name="server-409-Fault"/>
                    <wsdl:fault message="tns:post202FaultMessage" name="server-202-Fault"/>
                    <wsdl:fault message="tns:post500FaultMessage" name="server-500-Fault"/>
                </wsdl:operation>
            </wsdl:portType>
        </wsdl:definitions>
