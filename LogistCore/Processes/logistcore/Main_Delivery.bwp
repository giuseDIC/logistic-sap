    <bpws:scope name="scope">
        <bpws:faultHandlers>
            <bpws:catch faultElement="ns2:ErrorResponse"
                faultName="ns2:ErrorResponse"
                faultVariable="ErrorResponse" tibex:xpdlId="95160734-1051-4056-870d-98de7915d25e">
                <bpws:scope name="scope2">
                    <bpws:flow name="flow2">
                        <bpws:links>
                            <bpws:link name="LogErrorToPostError400" tibex:linkType="SUCCESSWITHCONDITION"/>
                            <bpws:link name="LogErrorToPostError404" tibex:linkType="SUCCESSWITHCONDITION"/>
                            <bpws:link name="LogErrorToPostError409" tibex:linkType="SUCCESSWITHCONDITION"/>
                        </bpws:links>
                        <bpws:extensionActivity>
                            <tibex:activityExtension
                                inputVariable="LogError-input"
                                name="LogError"
                                tibex:xpdlId="bf20e95c-d55c-46d6-82f6-ab0c4c702592" xmlns:tibex="http://www.tibco.com/bpel/2007/extensions">
                                <bpws:sources>
                                    <bpws:source linkName="LogErrorToPostError400">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="string( $ErrorResponse/ns2:code) = &quot;DELIVERY_DATA_REQUIRED&quot;" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[string( $ErrorResponse/ns2:code) = "DELIVERY_DATA_REQUIRED"]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="LogErrorToPostError404">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="string($ErrorResponse/ns2:code) = &quot;ORDER_NOT_FOUND&quot;" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[string($ErrorResponse/ns2:code) = "ORDER_NOT_FOUND"]]></bpws:transitionCondition>
                                    </bpws:source>
                                    <bpws:source linkName="LogErrorToPostError409">
                                    <tibex:DesignExpression>
                                    <tibex:expression
                                    expression="xsd:boolean(string( $ErrorResponse/ns2:code = &quot;INVALID_ORDER_STATUS&quot;))" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"/>
                                    </tibex:DesignExpression>
                                    <bpws:transitionCondition expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xpath2.0"><![CDATA[xsd:boolean(string( $ErrorResponse/ns2:code = "INVALID_ORDER_STATUS"))]]></bpws:transitionCondition>
                                    </bpws:source>
                                </bpws:sources>
                                <tibex:inputBindings>
                                    <tibex:inputBinding
                                    expression="&lt;?xml version=&quot;1.0&quot; encoding=&quot;UTF-8&quot;?>&#xa;&lt;xsl:stylesheet xmlns:xsl=&quot;http://www.w3.org/1999/XSL/Transform&quot; xmlns:tns1=&quot;http://www.tibco.com/pe/WriteToLogActivitySchema&quot; xmlns:tns=&quot;http://www.keypartner.com/logistic-sap/Error&quot; version=&quot;2.0&quot;>&lt;xsl:param name=&quot;ErrorResponse&quot;/>&lt;xsl:template name=&quot;LogError-input&quot; match=&quot;/&quot;>&lt;tns1:ActivityInput>&lt;message>&lt;xsl:value-of select=&quot;concat($ErrorResponse/tns:code, &amp;quot; &amp;quot;, $ErrorResponse/tns:message)&quot;/>&lt;/message>&lt;/tns1:ActivityInput>&lt;/xsl:template>&lt;/xsl:stylesheet>" expressionLanguage="urn:oasis:names:tc:wsbpel:2.0:sublang:xslt1.0"/>
                                </tibex:inputBindings>
                                <tibex:config>
                                    <bwext:BWActivity
                                    activityTypeID="bw.generalactivities.log"
                                    version="6.0.0.001"
                                    xmlns:activityconfig="http://tns.tibco.com/bw/model/activityconfig"
                                    xmlns:bwext="http://tns.tibco.com/bw/model/core/bwext"
                                    xmlns:generalactivities="http://ns.tibco.com/bw/palette/generalactivities" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
                                    <activityConfig>
                                    <properties name="config" xsi:type="activityconfig:EMFProperty">
                                    <type href="http://ns.tibco.com/bw/palette/generalactivities#//Log"/>
                                    <value
                                    controlBy="Application"
                                    role="Error"
                                    suppressJobInfo="true" xsi:type="generalactivities:Log"/>
                                    </properties>
                                    </activityConfig>
                                    </bwext:BWActivity>
                                </tibex:config>
                            </tibex:activityExtension>
                        </bpws:extensionActivity>
                        <bpws:reply faultName="server-400-Fault"
                            name="PostError400" operation="post"
